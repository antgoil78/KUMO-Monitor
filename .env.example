# Use the current DEV app; select TST after provisioning its app schemas.
# Full path to the DEFAULT / ENVIRONMENT parameter store. This is the only routing bootstrap.
KUMO_ENVIRONMENT_TABLE=KUMO_DEV.MONITOR_META.APPLICATION_PARAMETERS
KUMO_ENV=DEV
# Optional service label: DEV, TEST, UAT or PROD. Defaults to KUMO_ENV (TST => TEST).
# This label does not select a database or Snowflake account.
KUMO_DEPLOYMENT_ENV=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PASSCODE=
SNOWFLAKE_PASSCODE_IN_PASSWORD=false
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
KUMO_TASK_WAREHOUSE=KUMO_ELT_GEN_1
# DEV/TST scheduler tasks stay suspended unless explicitly enabled later.
# Blank keeps this default for the selected environment.
KUMO_AUTO_RESUME_TASKS=
KUMO_LIM_ROLE=KUMO_ADMIN
KUMO_USE_MOCK=false
KUMO_IMAGE_VERSION=latest
KUMO_REFRESH_SECONDS=5
KUMO_SHARED_LOCK_SYNC_SECONDS=1
KUMO_DASHBOARD_CACHE_SECONDS=30
KUMO_SESSION_CACHE_SECONDS=300
KUMO_ACTIVITY_LEASE_SECONDS=90
KUMO_LOOKUP_USER_PROFILE=false
SNOWFLAKE_LOGIN_TIMEOUT_SECONDS=15
SNOWFLAKE_NETWORK_TIMEOUT_SECONDS=45
SNOWFLAKE_SOCKET_TIMEOUT_SECONDS=30
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=1200
